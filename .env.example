DATABASE_URL=postgresql://user:password@host/db?sslmode=require
SIGNUP_CODE=choose-a-bootstrap-code
# Generate a separate VAPID pair for each deployment environment. Keep the private key server-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://splitwisest-kappa.vercel.app
# Empty disables push. Use comma-separated test user IDs during rollout; "all" enables opted-in users.
PUSH_ALLOWED_USER_IDS=
# At least 32 random characters. Used only by the delivery scheduler.
PUSH_CRON_SECRET=
